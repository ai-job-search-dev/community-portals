{
  "name": "icims-cli",
  "version": "1.0.0",
  "description": "CLI for reading employer job portals hosted on iCIMS from their public HTML — no authentication, zero runtime dependencies.",
  "type": "module",
  "main": "src/cli.ts",
  "bin": {
